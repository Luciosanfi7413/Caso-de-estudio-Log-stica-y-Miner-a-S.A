@startuml
title Modelo Entidad-Relación - Sistema de gestión de incidencias\nLogística y Minería S.A.

hide circle
skinparam linetype ortho
top to bottom direction

entity "PERSONA" as PERSONA {
  * id_persona : BIGINT <<PK>>
  --
  dni : VARCHAR(20) <<UQ>>
  nombre : VARCHAR(100)
  apellido : VARCHAR(100)
  correo : VARCHAR(254)
}

entity "EMPLEADO" as EMPLEADO {
  * id_persona : BIGINT <<PK, FK>>
}

entity "ESPECIALISTA_EXTERNO" as ESPECIALISTA {
  * id_persona : BIGINT <<PK, FK>>
  --
  telefono : VARCHAR(30)
  estado_habilitacion : VARCHAR(20)
}

entity "ROL" as ROL {
  * id_rol : INT <<PK>>
  --
  nombre : VARCHAR(50) <<UQ>>
}

entity "EMPLEADO_ROL" as EMPLEADO_ROL {
  * id_persona : BIGINT <<PK, FK>>
  * id_rol : INT <<PK, FK>>
}

entity "ESPECIALIDAD" as ESPECIALIDAD {
  * id_especialidad : BIGINT <<PK>>
  --
  nombre : VARCHAR(100) <<UQ>>
  descripcion : VARCHAR(255)
}

entity "ESPECIALISTA_ESPECIALIDAD" as ESPECIALISTA_ESPECIALIDAD {
  * id_persona : BIGINT <<PK, FK>>
  * id_especialidad : BIGINT <<PK, FK>>
}

entity "ELEMENTO" as ELEMENTO {
  * identificador_elemento : VARCHAR(100) <<PK>>
  --
  tipo_elemento : VARCHAR(40)
  descripcion : VARCHAR(255)
}

entity "INCIDENCIA" as INCIDENCIA {
  * id_incidencia : BIGINT <<PK>>
  --
  id_empleado_solicitante : BIGINT <<FK>>
  elemento_identificador : VARCHAR(100) <<FK>>
  fecha_hora_creacion : TIMESTAMP
  tipo_incidencia : VARCHAR(30)
  descripcion : TEXT
  prioridad : VARCHAR(10)
  estado_actual : VARCHAR(20)
  fecha_hora_actualizacion : TIMESTAMP
  fecha_hora_cierre : TIMESTAMP <<NULL>>
}

entity "ADJUNTO" as ADJUNTO {
  * id_adjunto : BIGINT <<PK>>
  --
  id_incidencia : BIGINT <<FK>>
  nombre_archivo : VARCHAR(255)
  tipo_archivo : VARCHAR(10)
  tamano_bytes : BIGINT
  ubicacion : VARCHAR(500)
}

entity "HISTORIAL" as HISTORIAL {
  * id_historial : BIGINT <<PK>>
  --
  id_incidencia : BIGINT <<FK>>
  id_persona : BIGINT <<FK>>
  fecha_hora : TIMESTAMP
  tipo_evento : VARCHAR(40)
  descripcion : TEXT
}

entity "ASIGNACION" as ASIGNACION {
  * id_asignacion : BIGINT <<PK>>
  --
  id_incidencia : BIGINT <<FK>>
  id_persona_asignada : BIGINT <<FK>>
  fecha_hora_asignacion : TIMESTAMP
  fecha_hora_fin : TIMESTAMP <<NULL>>
  estado_asignacion : VARCHAR(30)
}

PERSONA ||--o| EMPLEADO : "es"
PERSONA ||--o| ESPECIALISTA : "es"

EMPLEADO ||--o{ EMPLEADO_ROL : "tiene"
ROL ||--o{ EMPLEADO_ROL : "se asigna"

ESPECIALISTA ||--o{ ESPECIALISTA_ESPECIALIDAD : "posee"
ESPECIALIDAD ||--o{ ESPECIALISTA_ESPECIALIDAD : "corresponde a"

EMPLEADO ||--o{ INCIDENCIA : "registra"
ELEMENTO ||--o{ INCIDENCIA : "es afectado en"

INCIDENCIA ||--o{ ADJUNTO : "incluye"
INCIDENCIA ||--o{ HISTORIAL : "conserva"
PERSONA ||--o{ HISTORIAL : "realiza"

INCIDENCIA ||--o{ ASIGNACION : "registra"
PERSONA ||--o{ ASIGNACION : "es asignada a"

note right of ASIGNACION
Cada asignación o reasignación
se conserva como un registro.
El Responsable de Sistemas realiza
manualmente las reasignaciones.
end note

@enduml